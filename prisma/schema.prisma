// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL vive en prisma.config.ts (Prisma 7 ya no la acepta acá).
}

model Squad {
  id     Int    @id @default(autoincrement())
  // Único: el import matchea los squads por nombre, así que no puede haber dos iguales.
  nombre String @unique

  snapshots          SquadSnapshot[]
  initiatives        Initiative[]
  bloqueos           BloqueoSquad[]
  needs              Need[]
  upcomingDeliveries UpcomingDelivery[]
  achievements       Achievement[]
  unplannedIntakes   UnplannedIntake[]
  informesSemanales  InformeSquadSemanal[]

  @@map("squad")
}

model SquadSnapshot {
  id                      Int      @id @default(autoincrement())
  squadId                 Int      @map("squad_id")
  semanaInicio            DateTime @map("semana_inicio") @db.Date
  fechaReferencia         DateTime @map("fecha_referencia") @db.Date
  trimestre               String
  deliveryRealPct         Float    @map("delivery_real_pct")
  // Nullable: un squad solo-delivery (ej. Empresas, sin nodo Discovery en
  // Smartsheet) no tiene discovery. Null honesto, no un 0 que fingiría brecha.
  discoveryRealPct        Float?   @map("discovery_real_pct")
  deliveryManualOverride  Boolean  @default(false) @map("delivery_manual_override")
  discoveryManualOverride Boolean  @default(false) @map("discovery_manual_override")
  esperadoPct             Float    @map("esperado_pct")
  deliveryDeltaPct        Float    @map("delivery_delta_pct")
  discoveryDeltaPct       Float?   @map("discovery_delta_pct")
  semaforo                String
  frasePronostico         String?  @map("frase_pronostico")
  editadoPor              String   @map("editado_por")

  squad Squad @relation(fields: [squadId], references: [id])

  // Una sola fila por squad por semana: dentro de la semana se actualiza en el
  // lugar, entre semanas nunca se pisa (SDD, historial completo).
  @@unique([squadId, semanaInicio])
  @@map("squad_snapshot")
}

model Initiative {
  id            Int      @id @default(autoincrement())
  squadId       Int      @map("squad_id")
  // Identidad estable de la fila en Smartsheet (columna V "Identificador de la
  // fila"): único por fila y no se reusa. Es la clave del upsert, no el código
  // IBD, que se repite entre filas. Nullable porque el adaptador CSV no lo trae.
  smartsheetRowId String? @map("smartsheet_row_id")
  // El código IBD: informativo, no identidad (se repite en la planilla real).
  codigoExterno String?  @map("codigo_externo")
  // Marca la iniciativa como parte del portafolio (columna C). Sólo importamos
  // las que la tienen; el resto del árbol son tareas/subtareas.
  portafolio    Boolean  @default(false)
  nombre        String
  tipo          String
  // Etapa del pipeline (columna L): "Despliegue", "Desarrollo", … Nullable: hay
  // iniciativas de portafolio sin etapa cargada.
  etapa         String?
  estado        String
  // Nullables por huecos reales en la planilla: no todas las filas de portafolio
  // traen % o fechas cargados.
  pctAvance     Float?   @map("pct_avance")
  fechaInicio   DateTime? @map("fecha_inicio") @db.Date
  // Fecha de Finalización planificada (columna I).
  fechaFin      DateTime? @map("fecha_fin") @db.Date
  // Fecha Fin Real (columna R): se completa cuando la iniciativa cierra.
  fechaFinReal  DateTime? @map("fecha_fin_real") @db.Date
  // Trimestre al que pertenece la iniciativa según su nodo Q ancestro en el árbol
  // ("Q3-2026"). Es lo que acota "pases a producción" al Q en curso. Nullable: el
  // CSV no lo trae y puede haber filas sin Q ancestro.
  trimestre     String?
  semanaInicio  DateTime @map("semana_inicio") @db.Date

  squad Squad @relation(fields: [squadId], references: [id])

  // Clave natural del upsert del import: la fila de Smartsheet. Nullable no
  // colisiona en Postgres, así una fila del CSV (sin rowId) se inserta nueva.
  @@unique([squadId, smartsheetRowId])
  @@map("initiative")
}

// Bloqueo estructurado: impedimento real que frena al squad. Los riesgos (notas
// informales) ya no son entidad; van como texto libre en InformeSquadSemanal.riesgos.
model Bloqueo {
  id          Int       @id @default(autoincrement())
  descripcion String
  severidad   Severidad
  // Fechas opcionales: inicio del bloqueo y estimación de resolución.
  desde       DateTime? @db.Date
  hasta       DateTime? @db.Date
  resuelto    Boolean   @default(false)
  resueltoEn  DateTime? @map("resuelto_en")
  // Cómo se resolvió (texto libre): Dai lo narra en su bitácora.
  notaResolucion String? @map("nota_resolucion")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  squads BloqueoSquad[]

  @@map("bloqueo")
}

// Un mismo bloqueo puede pegarle a varios squads a la vez sin duplicar la fila.
model BloqueoSquad {
  bloqueoId Int @map("bloqueo_id")
  squadId   Int @map("squad_id")

  bloqueo Bloqueo @relation(fields: [bloqueoId], references: [id])
  squad   Squad   @relation(fields: [squadId], references: [id])

  @@id([bloqueoId, squadId])
  @@map("bloqueo_squad")
}

enum Severidad {
  ALTA
  MEDIA
  BAJA
}

model Need {
  id           Int         @id @default(autoincrement())
  squadId      Int         @map("squad_id")
  descripcion  String
  // dueno queda por compatibilidad; ya no se carga desde la UI (Dai no lo usa).
  dueno        String
  // Fecha del pedido (se pone hoy al crear pero es editable). Estado reemplaza al
  // simple "resuelto", que se conserva derivado (resuelto = estado RESUELTA).
  fecha        DateTime    @default(now()) @db.Date
  estado       EstadoAyuda @default(ABIERTA)
  semanaInicio DateTime    @map("semana_inicio") @db.Date
  resuelto     Boolean     @default(false)

  squad Squad @relation(fields: [squadId], references: [id])

  @@map("need")
}

enum EstadoAyuda {
  ABIERTA
  MITIGADA_PARCIALMENTE
  RESUELTA
}

model UpcomingDelivery {
  id            Int      @id @default(autoincrement())
  squadId       Int      @map("squad_id")
  descripcion   String
  fechaEstimada DateTime @map("fecha_estimada") @db.Date
  semanaInicio  DateTime @map("semana_inicio") @db.Date

  squad Squad @relation(fields: [squadId], references: [id])

  @@map("upcoming_delivery")
}

model Achievement {
  id           Int      @id @default(autoincrement())
  squadId      Int      @map("squad_id")
  descripcion  String
  semanaInicio DateTime @map("semana_inicio") @db.Date

  squad Squad @relation(fields: [squadId], references: [id])

  @@map("achievement")
}

// Intake, NO plata: iniciativas que entraron al portafolio sin planificar.
// Distinto de Risk.categoria_impacto='ingresos' (revenue). Ver SDD "Ojo con ingresos".
model UnplannedIntake {
  id           Int      @id @default(autoincrement())
  squadId      Int      @map("squad_id")
  descripcion  String
  semanaInicio DateTime @map("semana_inicio") @db.Date

  squad Squad @relation(fields: [squadId], references: [id])

  @@map("unplanned_intake")
}

// Staging del import de dos fases. Vive en Postgres, no en memoria de proceso:
// en Vercel serverless el POST /api/import y el confirm posterior pueden caer en
// instancias distintas, así que la memoria no alcanza para retener el batch.
model ImportStaging {
  token     String   @id
  payload   Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("import_staging")
}

// Narrativa del informe ejecutivo GENERAL (portafolio) por semana. La escribe Dai
// a mano; ninguno de estos campos se auto-genera. Una fila por semana.
// pases_planificados es el KPI 4 (número que Dai maneja verbalmente, no cálculo).
model InformeSemanal {
  id                Int      @id @default(autoincrement())
  semanaInicio      DateTime @unique @map("semana_inicio") @db.Date
  novedades         String?
  lectura           String?
  pasesPlanificados Int?     @map("pases_planificados")

  @@map("informe_semanal")
}

// Narrativa del informe INDIVIDUAL por squad y por semana. Novedades,
// pases_produccion y despriorizaciones son texto libre nuevo; el resto de las
// secciones del informe individual (próximas entregas, ingresos no planificados,
// necesitamos, bloqueos) reutilizan las entidades existentes. pases_planificados
// es el KPI 4 de ese squad.
model InformeSquadSemanal {
  id                Int      @id @default(autoincrement())
  squadId           Int      @map("squad_id")
  semanaInicio      DateTime @map("semana_inicio") @db.Date
  novedades         String?
  pasesProduccion   String?  @map("pases_produccion")
  despriorizaciones String?
  // Riesgos como texto libre (antes eran la entidad Risk, ahora notas informales).
  riesgos           String?
  pasesPlanificados Int?     @map("pases_planificados")

  squad Squad @relation(fields: [squadId], references: [id])

  @@unique([squadId, semanaInicio])
  @@map("informe_squad_semanal")
}

// Bitácora de cambios de la narrativa (Bloque E). Cada fila es una versión previa
// de un campo, guardada al pisarlo. Se conservan hasta 5 por (tabla, registro, campo);
// las más viejas se borran. `tabla` es el nombre físico (informe_semanal /
// informe_squad_semanal) y `campo` la clave snake_case del body de la API.
model NarrativeHistory {
  id            Int      @id @default(autoincrement())
  tabla         String
  registroId    Int      @map("registro_id")
  campo         String
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  cambiadoEn    DateTime @default(now()) @map("cambiado_en") @db.Timestamptz(6)

  @@index([tabla, registroId, campo], map: "narrative_history_registro_idx")
  @@map("narrative_history")
}
